# Copy this file to .env.local and fill in real values for your machine.
# Vite only exposes variables prefixed VITE_ to client code.

# Base URL the frontend's API client (src/api/client) prepends to every
# request path (every module calls bare paths like '/auth/login',
# '/admin/caterers' — none include the backend's own '/api' mount prefix).
# Must include that prefix here, e.g. http://localhost:4000/api for the
# default backend port (see backend/.env.example). Left empty, every
# request 404s against this dev server's own origin instead of reaching
# the backend.
VITE_API_BASE_URL=http://localhost:4000/api

# Dev-only escape hatch: set to "true" to skip both the /admin ProtectedRoute
# and the /client CatererProtectedRoute login gates. Never set this in a
# real/shared build — see development/phase-1-foundation/AUTHENTICATION.md.
VITE_SKIP_AUTH=
